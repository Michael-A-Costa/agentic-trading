<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: BTC trend sleeve, 15:50 ET weekday check-in (reconcile + stop guard). PLACES REAL ORDERS when TREND_ARMED=1.
  Times are LOCAL (this Mac runs US/Eastern). Pairs with the other com.agentic.trend-* plist.

  Install:  sed "s#/ABSOLUTE/PATH/TO#$HOME#g" scripts/com.agentic.trend-close.plist > ~/Library/LaunchAgents/com.agentic.trend-close.plist
            launchctl load -w ~/Library/LaunchAgents/com.agentic.trend-close.plist
  Stop:     launchctl unload -w ~/Library/LaunchAgents/com.agentic.trend-close.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentic.trend-close</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/ABSOLUTE/PATH/TO/agentic-trading/scripts/run_trend.sh</string>
        <string>close</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/agentic-trading</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/agentic-trading/data/logs/trend-close.out</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/agentic-trading/data/logs/trend-close.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
